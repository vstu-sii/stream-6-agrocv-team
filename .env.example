# Пример переменных окружения. Скопируйте в .env:  cp .env.example .env
# В репозиторий .env не попадает никогда.

# --- Приложение ---
APP_NAME=agrocv-api
APP_STAGE=dev
LOG_LEVEL=INFO

# --- Порты, публикуемые на хосте ---
API_PORT=8000
STUB_PORT=8080

# --- Внешний модельный шлюз ---
# В dev-окружении это заглушка внутри compose (stub-gateway).
# В проде здесь адрес настоящего шлюза.
MODEL_BASE_URL=http://stub-gateway:8080
# Ключ к настоящей модели. В dev не нужен, в проде задаётся секретом на сервере.
MODEL_API_KEY=
