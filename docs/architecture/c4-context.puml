@startuml c4-context
!include <C4/C4_Context>

title AgroCV — C4 Level 1 (System Context)

Person(gardener, "Новичок в саду", "Фотографирует растение, хочет понять, что с ним не так, и что делать")
Person(agronomist, "Агроном / продавец питомника", "Ставит диагноз по листу, отвечает за назначение обработки")

System(agrocv, "AgroCV", "Диагностика болезней растений по фото: распознаёт растение, ставит диагноз и предлагает конкретное лечение")

System_Ext(model_provider, "Модельный провайдер", "Облачные VLM/LLM по API: распознавание растения и текст диагноза")
System_Ext(drug_reference, "Справочник препаратов", "Внешний источник: препарат, дозировка, срок ожидания")

Rel(gardener, agrocv, "Загружает фото, получает диагноз и назначение", "HTTPS")
Rel(agronomist, agrocv, "Проверяет диагноз и назначение, ведёт журнал ухода", "HTTPS")
Rel(agrocv, model_provider, "Отправляет фото и промпт, получает распознавание и диагноз", "HTTPS")
Rel(agrocv, drug_reference, "Уточняет препарат, дозировку и срок ожидания", "HTTPS")

SHOW_LEGEND()
@enduml
